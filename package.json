{
  "name": "hyderabad-links",
  "private": true,
  "version": "0.0.0",
  "description": "HYDERABAD LINKS monorepo: three Next.js websites, one ASP.NET Core API, one Microsoft SQL Server database.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/main-website",
    "apps/admin-website",
    "apps/super-admin-website",
    "packages/*"
  ],
  "scripts": {
    "dev:main": "npm run dev -w apps/main-website",
    "dev:admin": "npm run dev -w apps/admin-website",
    "dev:super-admin": "npm run dev -w apps/super-admin-website",
    "db:migrate": "dotnet run --project backend/BusinessDirectory.Api -- migrate",
    "db:baseline": "dotnet run --project backend/BusinessDirectory.Api -- db-baseline",
    "db:export": "dotnet run --project backend/BusinessDirectory.Api -- db-export",
    "db:seed-dev": "dotnet run --project backend/BusinessDirectory.Api -- seed-dev",
    "db:check": "dotnet run --project backend/BusinessDirectory.Api -- db-check",
    "dev:api": "dotnet run --project backend/BusinessDirectory.Api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "verify": "npm run check:migrations && npm run test:scripts && npm run typecheck && npm run build && dotnet build backend/BusinessDirectory.sln && dotnet test backend/BusinessDirectory.sln",
    "db:reset": "dotnet run --project backend/BusinessDirectory.Api -- db-reset",
    "db:repair": "dotnet run --project backend/BusinessDirectory.Api -- db-repair"
  }
}
