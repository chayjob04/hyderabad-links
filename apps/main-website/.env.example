# Server-side runtime settings for main-website. Copy to .env.local for local development.
# These are read at RUNTIME on the server, so one build can be deployed to staging and production.
API_BASE_URL=http://localhost:5080
APP_ENV=LOCAL
# The public origin, used for canonical links, structured data and the sitemap. Set this on every
# deployment: without it the site falls back to Vercel's own production domain, and only then to
# localhost. It must have no trailing slash.
SITE_URL=http://localhost:3000

# Shared secret the admin site sends to /api/revalidate so an approved listing appears at once.
# Leave it empty to turn the endpoint off; pages then refresh on their own within a minute.
REVALIDATE_TOKEN=
