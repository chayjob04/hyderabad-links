{
  "//": [
    "Copy to appsettings.Development.json, which is git-ignored.",
    "",
    "Secrets do NOT belong in that copy either, even though it is ignored: an ignored file is one",
    "`git add -f` or one zip away from being shared. Put them in user-secrets, which live outside the",
    "working tree entirely:",
    "",
    "  dotnet user-secrets set \"ConnectionStrings:Default\" \"<your Azure SQL connection string>\" --project backend/BusinessDirectory.Api",
    "  dotnet user-secrets set \"Media:BlobConnectionString\" \"<dev storage connection string>\" --project backend/BusinessDirectory.Api",
    "",
    "In Azure none of this is read: App Service application settings supply the same keys.",
    "",
    "Point the database at a development or test database, never production. `npm run db:migrate`",
    "changes whatever it is pointed at, and `npm run db:check` prints the server and database it is",
    "about to use for exactly that reason."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "Auth": {
    "// dummy otp": "Development and testing only, and temporary. With DummyOtpEnabled true, every owner login code is 123456 and no SMS is sent, so sign-in can be tested before MSG91 delivery is proven. Everything after the code - the account, the session, the tokens - is unchanged.",
    "// the catch": "It is an authentication bypass: anyone who can reach the API can sign in as any phone number. It is announced on every start and logged on every code issued. Set it to false, or remove it, before anyone else can reach the site.",
    "DummyOtpEnabled": false
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002"
    ]
  },

  "Media": {
    "//": "Empty refuses uploads with an explanation rather than accepting files nothing can store. Set it in user-secrets to work on photos, logos and video.",
    "BlobConnectionString": "",
    "ContainerName": "listing-media"
  },

  "Payments": {
    "//": "Unset means there is no checkout at all: the subscription endpoints answer 503 and write nothing, which is the honest state while no provider account exists.",
    "// razorpay": "Set Provider to 'razorpay' to switch payments on. It then needs KeyId and KeySecret, and a WebhookSecret for the delivery that does not depend on the customer's browser. Put the two secrets in user-secrets or Key Vault, never in this file: dotnet user-secrets set \"Payments:KeySecret\" \"...\"",
    "// test mode": "Razorpay's test keys (rzp_test_...) take no real money and are the right thing to develop against. The price and the plan come from the plans table, not from here.",
    "// untested": "No payment has ever been taken by this project. Until one is, and the subscription it bought has been seen in the database, treat payments as unverified.",
    "Provider": "",
    "PlanSlug": "verified",
    "PeriodMonths": 12
  },

  "Email": {
    "//": "'console' prints the message instead of sending it, so local work never emails a real person.",
    "// resend": "Set Provider to 'resend' to use the real provider (decision D14). It then also needs ApiKey and a FromAddress on a domain verified with Resend. Put ApiKey in user-secrets or Key Vault, never in this file: dotnet user-secrets set \"Email:ApiKey\" \"re_...\"",
    "// untested": "The Resend adapter has never sent a real message. Until one goes out and arrives, treat email as unverified; every attempt is recorded in the notifications table either way.",
    "Provider": "console",
    "FromAddress": "no-reply@hyderabadlinks.local",
    "ReplyTo": "hello@hyderabadlinks.local",
    "SiteBaseUrl": "http://localhost:3000"
  }
}
